# ======================================================================
# 个人博客配置模板
# 使用方法：
#   1) 复制本文件为 .env（和 config.py 同目录）
#   2) 按下方注释修改你需要的项
#   3) 重启博客（run.bat / launcher.py 重启）即可生效
#
# 原理：config.py 启动时优先读取 .env，再回落到 os.environ，
#       最后才使用内置默认值。所以 .env 的优先级最高。
# ======================================================================

# -------------------- 安全 & 账号 --------------------
# Flask 会话密钥：生产环境必须修改（任意长随机字符串，32+ 字符）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-please

# 后台管理员账号（登录 /admin/login/）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# -------------------- 网络 --------------------
# 监听地址：0.0.0.0 = 允许同局域网访问；127.0.0.1 = 仅限本机
BLOG_HOST=0.0.0.0
# 监听端口：默认 5000
BLOG_PORT=5000

# -------------------- 数据库 --------------------
# 默认 SQLite（0 配置，推荐个人用）；如需 MySQL/PostgreSQL 可改成：
#   MySQL: mysql+pymysql://user:pass@127.0.0.1:3306/blog?charset=utf8mb4
#   PostgreSQL: postgresql+psycopg2://user:pass@127.0.0.1:5432/blog
DATABASE_URL=sqlite:///blog.db

# -------------------- 运行模式 --------------------
# 调试模式：1=开启（热重载、详细报错），生产必须保持 0
FLASK_DEBUG=0
